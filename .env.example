# PostgreSQL (util/postgres_connection.py — connect_postgres)
# 방식 A: host/port 등을 따로 적기 (DATABASE_URL 은 비우거나 주석)
# DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph_edu

# 방식 B: 한 줄 URL (설정 시 POSTGRES_* 보다 우선)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/langgraph_edu
